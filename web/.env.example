# Base URL of the backend API (see API_CONTRACT.md at the repo root)
VITE_API_BASE_URL=http://localhost:8080/api

# When true, the app boots against an in-browser MSW mock server instead of
# the real backend. Flip to false once the real API is reachable at
# VITE_API_BASE_URL — no code changes required.
VITE_USE_MOCKS=true
